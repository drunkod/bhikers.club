(ns club.bhikers.screens.aroundme.layers
  (:require ["package:flutter/material.dart" :as m]
            ["package:agus_maps_flutter/agus_maps_flutter.dart" :as agus]
            [club.bhikers.lib.state :as state]
            [club.bhikers.lib.config :as config]
            [club.bhikers.lib.logging :as logging]
            [cljd.flutter :as f]))

(defn on-map-ready []
  (logging/d "AgusMap surface ready!"))

(defn base-map-layer []
  (f/widget
   :watch [map-controller state/map-controller]
   (if map-controller
     (agus/AgusMap
      .initialLat (:lat config/default-location)
      .initialLon (:lon config/default-location)
      .initialZoom (:zoom config/default-location)
      .controller map-controller
      .onMapReady on-map-ready
      .isVisible true)
     (m/Center .child (m/CircularProgressIndicator)))))

(defn pois-markers-widget []
  (m/Container))

(defn current-center-marker [current-pos-as-center? current-center]
  (m/Container))

(defn current-location-marker-style [current-pos-as-center? theme]
  nil)
