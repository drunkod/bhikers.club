(ns club.bhikers.lib.pois
(:require
["package:latlong2/latlong.dart" :refer [LatLng]]
[club.bhikers.lib.config :refer [poi-types->osm-tags]]
[club.bhikers.lib.logging :as logging]
[club.bhikers.lib.overpassapi :as oapi]))

;; Persistent cache for POI query parameters - survives widget rebuilds
;; Prevents unnecessary API calls during language changes
(def ^:private last-poi-query-params (atom nil))

(defn poi-type->osm-tags [type] (get poi-types->osm-tags type false))

(defn overpass-item->poi
  "Converts an Overpass API item to a POI map.
  Injects lat/lon for 'way' items by finding their first node.
  Returns a new immutable map with the injected fields."
  [item items selected-poi-type]
  (let [;; Convert Dart Map to Clojure Map to support assoc/immutability
        item (into {} item)
        ;; Add poi-type if not present
        with-type (if (contains? item "poi-type")
                    item
                    (assoc item "poi-type" selected-poi-type))]
    ;; For 'way' items, inject lat/lon from the first node
    (if (= (get with-type "type") "way")
      (let [first-node-id (first (get with-type "nodes" []))
            first-way-node (when first-node-id
                             (some #(when (= first-node-id (get % "id")) %)
                                   items))]
        (cond-> with-type
          (and first-way-node (not (contains? with-type "lat")))
          (assoc "lat" (get first-way-node "lat"))

          (and first-way-node (not (contains? with-type "lon")))
          (assoc "lon" (get first-way-node "lon"))))
      with-type)))

(defn fetch-pois-by-type
"Fetches POIs of a specific OSM type (node/way) for given tags.
Returns a list of POI maps."
[overpass-api t lat lon tags radius selected-poi-type]
(let [all-items (await (oapi/query overpass-api t lat lon tags radius))]
(if (nil? all-items)
nil
(let [typed-items (filter #(= t (get % "type")) all-items)]
(map #(overpass-item->poi % all-items selected-poi-type) typed-items)))))

(defn dynamic-map-pois
"Creates a reactive POI atom that updates based on map state changes.
It manages API queries and updates the 'pois' atom accordingly."
[map-state overpass-api]
(let [pois (atom [])
query-reporter (atom "")]
(add-watch query-reporter :report-map-msg (fn [_ _ _ new-msg] (swap! map-state assoc :message new-msg)))
    (add-watch map-state :refresh-pois
      (fn [_ _ old-state new-state]
        (when (not= (select-keys old-state [:radius :selected-poi-type :current-pos :current-center :current-pos-as-center?])
                    (select-keys new-state [:radius :selected-poi-type :current-pos :current-center :current-pos-as-center?]))
          (let [{:keys [radius selected-poi-type current-pos current-center current-pos-as-center?]} new-state
                [lat lon] (if (and current-pos-as-center? current-pos) current-pos current-center)
                osm-tags (poi-type->osm-tags selected-poi-type)
                ;; Build query params to check against cache
                query-params {:lat lat :lon lon :radius radius :selected-poi-type selected-poi-type}]
            (when (or (and current-pos-as-center? current-pos) current-center)
              ;; Skip refresh if query params match cached values (e.g. after language change rebuild)
              (if (= query-params @last-poi-query-params)
                (logging/d "skipping pois refresh - params unchanged (likely language change rebuild)")
                (do
                  (logging/d "refreshing pois!")
                  (reset! last-poi-query-params query-params)
                  (reset! pois [])
                  (doseq [t ["node" "way"]
                          tags (partition-all 2 osm-tags)]
                    (reset! query-reporter (str "fetch:" t tags))
                    (let [_pois (await (fetch-pois-by-type overpass-api t lat lon tags radius selected-poi-type))]
                      (cond
                        (nil? _pois)
                        (reset! query-reporter (str "FAILED! " t tags))
                        (empty? _pois)
                        (logging/d "no pois fetched! map-state was: " new-state)
                        :else
                        (do (logging/d "adding " (count _pois) " pois fetched!")
                            (swap! pois into _pois)))))
                  (reset! query-reporter (str "fetched " (count @pois) " pois.")))))))))


pois))

(defn poi->LatLng [poi] (LatLng (get poi "lat") (get poi "lon")))
