(ns club.bhikers.lib.map.widgets
  "Map UI widgets."
  (:require ["package:flutter/material.dart" :as m]
            [club.bhikers.lib.state :refer [debug-mode?]]
            [club.bhikers.lib.logging :as logging]
            [cljd.flutter :as f]))

;; =============================================================================
;; Map Widgets (simplified for agus_maps_flutter)
;; =============================================================================

(defn msg
  "Display debug message overlay on map (only in debug mode)."
  []
  (f/widget
   :get [:map-state]
   :watch [{:keys [message]} map-state]
   (if (not-empty message)
     (m/Align
      .alignment m/Alignment.bottomCenter
      .child (m/Padding
              .padding (m/EdgeInsets.only .bottom 50)
              .child (m/Container
                      .decoration (m/BoxDecoration
                                   .color m/Colors.white
                                   .border (m/Border.all)
                                   .borderRadius (m/BorderRadius.circular 5))
                      .child (m/Padding
                              .padding (m/EdgeInsets.all 5)
                              .child (m/Text message .overflow m/TextOverflow.ellipsis)))))
     (m/Container))))
