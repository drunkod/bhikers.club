(ns club.bhikers.lib.map.state
  "Map state management and stream logic."
  (:require ["package:geolocator/geolocator.dart" :as geo]
            ["dart:async" :as async]
            [club.bhikers.lib.notifications :refer [debug-notif]]
            [club.bhikers.lib.state :refer [debug-mode? selected-poi-type pois-radius]]
            [club.bhikers.lib.i18n :refer [l10n-str]]
            [club.bhikers.lib.logging :as logging]
            [club.bhikers.lib.position
             :refer [new-position-stream-controller
                     new-position-bstream
                     subscribe-position-stream
                     force-current-position]]))

;; =============================================================================
;; State Management (simplified for agus_maps_flutter)
;; =============================================================================

(defn new-state
  "Create a new map state atom."
  []
  (atom {:current-position nil
         :current-center nil
         :current-pos-as-center? true
         :align-position-on-update true
         :error nil
         :pois []}))

(defn ->state-streams
  "Create state streams for position updates."
  [state]
  {:state state
   :position-controller (new-position-stream-controller)})

(defn init!
  "Initialize map state streams and position tracking."
  [{:keys [state position-controller] :as streams}]
  (logging/d "Initializing map state...")
  (try
    ;; Subscribe to position updates
    (subscribe-position-stream 
     (new-position-bstream position-controller)
     (fn [lat lon]
       (when (and lat lon)
         (swap! state assoc 
                :current-position [lat lon]
                :current-center [lat lon])))
     :on-error (fn [err]
                 (logging/e "Position stream error: " err)
                 (swap! state assoc :error err)))
    
    ;; Try to get initial position
    (try
      (let [pos (await (force-current-position))]
        (when pos
          (swap! state assoc 
                 :current-position [(.-latitude ^geo/Position pos) (.-longitude ^geo/Position pos)]
                 :current-center [(.-latitude ^geo/Position pos) (.-longitude ^geo/Position pos)])))
      (catch Exception e
        (logging/e "Error getting initial position: " e)
        (swap! state assoc :error e)))
    
    (catch Exception e
      (logging/e "Error initializing map state: " e)
      (swap! state assoc :error e)))
  
  streams)

(defn dispose!
  "Dispose map state streams."
  [{:keys [position-controller] :as streams}]
  (logging/d "Disposing map state...")
  (when position-controller
    (try
      (.close ^async/StreamController position-controller)
      (catch Exception e
        (logging/e "Error closing position controller: " e))))
  nil)
